{
  "name": "engineers",
  "private": true,
  "type": "module",
  "scripts": {
    "swarm": "bun scripts/swarm.ts",
    "check": "bun scripts/check-template.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": "prettier --write"
  }
}
