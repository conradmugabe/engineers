{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Test",
  "type": "object",
  "required": [
    "id",
    "targetId",
    "acceptanceCriterion",
    "type",
    "action",
    "expectedResult",
    "automationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TEST-[A-Z0-9-]+$"
    },
    "targetId": {
      "type": "string"
    },
    "acceptanceCriterion": {
      "type": "string"
    },
    "type": {
      "enum": [
        "UNIT",
        "COMPONENT",
        "CONTRACT",
        "INTEGRATION",
        "E2E",
        "VISUAL",
        "SECURITY",
        "PERFORMANCE",
        "MANUAL"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "string"
    },
    "expectedResult": {
      "type": "string"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "automationStatus": {
      "enum": [
        "PLANNED",
        "AUTOMATED",
        "MANUAL_REQUIRED",
        "NOT_APPLICABLE"
      ]
    },
    "result": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}