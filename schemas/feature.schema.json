{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Feature",
  "type": "object",
  "required": [
    "id",
    "name",
    "purpose",
    "requirementIds",
    "goals",
    "nonGoals",
    "behavior",
    "releaseScope",
    "acceptanceCriteria",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavior": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonFunctionalExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "releaseScope": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}